# Copy this file to .env and fill in your own key. Never commit .env.
#
# How to get a YouTube Data API v3 key (free):
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or reuse one)
#   3. APIs & Services -> Library -> enable "YouTube Data API v3"
#   4. APIs & Services -> Credentials -> Create Credentials -> API key
#   5. (Recommended) Restrict the key to "YouTube Data API v3" only
#
# Free quota is 10,000 units/day. A search.list call costs 100 units,
# so this tool's default weekly run (a handful of searches) costs well
# under 1% of the daily quota.
YOUTUBE_API_KEY=
